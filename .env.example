# Salin ke .env dan isi dengan key kamu. JANGAN PERNAH commit file .env.
# Semua sumber di blueprint gratis; key di bawah ini semuanya paket gratis.
# Lihat config/sources.yaml untuk sumber tiap key.

# Jupiter Prediction API (key gratis dari Portal) — harga ¢ jup.ag
JUPITER_API_KEY=

# The Odds API paket gratis (500 kredit/bulan) — cadangan harga pembanding
ODDS_API_KEY=

# Polymarket & Kalshi: API publik, tidak perlu key untuk harga (Tahap 2 akan
# mengonfirmasi; kalau ternyata butuh key, tambahkan di sini, bukan di kode).
